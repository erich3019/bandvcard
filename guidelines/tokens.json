  "shadow": [
    { "name": "shadow-card-hover", "light": "0 2px 8px rgba(15,23,42,0.06)", "dark": "0 2px 8px rgba(0,0,0,0.4)", "usage": "Einziger Schatten: Hover verschiebbarer Karten. Popover und Dialoge dürfen einen Schatten tragen, weil sie über dem Inhalt schweben." }
  ]
