{
  "name": "Designguide",
  "version": 4,
  "meta": {
    "basis": "ERP Designguide v3 (designguidelines/), verallgemeinert für beliebige Projekte",
    "updated": "2026-10-16",
    "prefix": "ds",
    "build": "node guidelines/scripts/build-tokens.mjs erzeugt css/tokens.css und css/profiles/*.css und prüft alle Kontraste"
  },

  "color": {
    "base": [
      { "name": "page",           "light": "#f8f9fa", "dark": "#0b1220", "usage": "Seitengrund, Tabellenkopf, Zeilen-Hover, berechnete (schreibgeschützte) Felder." },
      { "name": "surface",        "light": "#ffffff", "dark": "#131c2b", "usage": "Panels, Karten, Topbar, Eingabefelder." },
      { "name": "column",         "light": "#eef1f4", "dark": "#1a2434", "usage": "Kanban-Spalten." },
      { "name": "ink",            "light": "#0f172a", "dark": "#e6ebf2", "usage": "Haupttext, Titel, Zahlen." },
      { "name": "ink-secondary",  "light": "#334155", "dark": "#c4cdd9", "usage": "Fliesstext in Notizen, Werte in Sekundär-Buttons; Text auf `column`." },
      { "name": "ink-tertiary",   "light": "#475569", "dark": "#aab4c3", "usage": "Text neutraler Badges und Tags auf `divider`." },
      { "name": "muted",          "light": "#5b6b80", "dark": "#97a3b5", "usage": "Labels, Untertitel, Metazeilen, Zeitstempel. 4.5:1 auch auf `divider` (v3: #64748b erreichte dort nur 4.3:1)." },
      { "name": "subtle",         "light": "#94a3b8", "dark": "#6b7a90", "usage": "Nur Nicht-Text: Chevrons, Achsen, Platzhalter-Icons, deaktivierte Schritte." },
      { "name": "border",         "light": "#e2e8f0", "dark": "#2a3647", "usage": "Rahmen von Panels, Karten, Buttons, Tabellenkopf, Topbar." },
      { "name": "border-strong",  "light": "#cbd5e1", "dark": "#5b6d86", "usage": "Hover-Rahmen von Karten, Vergleichsserie in Diagrammen." },
      { "name": "input",          "light": "#7f8ea3", "dark": "#5b6d86", "usage": "Rahmen von Eingabefeldern, Selects und Checkboxen: 3:1 (WCAG 1.4.11). Neu in v4." },
      { "name": "divider",        "light": "#f1f5f9", "dark": "#1e293b", "usage": "Trennlinien zwischen Zeilen, Hover von Icon-Buttons, neutrale Badges." },
      { "name": "logo-bg",        "light": "#ffffff", "dark": "#ffffff", "usage": "Kachel hinter hochgeladenen Logos, in beiden Themes weiss." },

      { "name": "sidebar-ink-strong", "light": "#ffffff",                "dark": "#ffffff",                "usage": "Aktiver Eintrag, Hover, Produktname in der Sidebar." },
      { "name": "sidebar-ink",        "light": "rgba(255,255,255,0.8)",  "dark": "rgba(255,255,255,0.8)",  "usage": "Inaktive Navigationseinträge." },
      { "name": "sidebar-ink-muted",  "light": "rgba(255,255,255,0.7)",  "dark": "rgba(255,255,255,0.7)",  "usage": "Gruppenlabels, Rolle, Untertitel in der Sidebar." },
      { "name": "sidebar-hover",      "light": "rgba(255,255,255,0.1)",  "dark": "rgba(255,255,255,0.1)",  "usage": "Hover von Navigationseinträgen, Trennlinien." },
      { "name": "sidebar-active",     "light": "rgba(255,255,255,0.14)", "dark": "rgba(255,255,255,0.14)", "usage": "Aktiver Navigationseintrag." },
      { "name": "sidebar-card",       "light": "rgba(255,255,255,0.06)", "dark": "rgba(255,255,255,0.06)", "usage": "Benutzerkarte unten in der Sidebar." },

      { "name": "success",        "light": "#16a34a", "dark": "#4ade80", "usage": "Positiv, nur Punkte und Balken ohne Text." },
      { "name": "success-strong", "light": "#15803d", "dark": "#4ade80", "usage": "Text positiver Badges und Trends." },
      { "name": "success-bg",     "light": "#f0fdf4", "dark": "#12301f", "usage": "Grund positiver Badges." },
      { "name": "info",           "light": "#1d4ed8", "dark": "#93b4f8", "usage": "Information, «in Bearbeitung», «gesendet»." },
      { "name": "info-bg",        "light": "#eff6ff", "dark": "#172540", "usage": "Grund informativer Badges." },
      { "name": "warning",        "light": "#d97706", "dark": "#fbbf24", "usage": "Warnung, nur Punkte und Balken ohne Text." },
      { "name": "warning-strong", "light": "#b45309", "dark": "#fbbf24", "usage": "Text von Warn-Badges («Offen», «Überfällig»)." },
      { "name": "warning-bg",     "light": "#fffbeb", "dark": "#33270e", "usage": "Grund von Warn-Badges." },
      { "name": "danger",         "light": "#b91c1c", "dark": "#f87171", "usage": "Kritisch, destruktive Aktionen, Fehlermeldungen." },
      { "name": "on-danger",      "light": "#ffffff", "dark": "#0b1220", "usage": "Text auf gefülltem `danger` (destruktiver Primär-Button)." },
      { "name": "danger-bg",      "light": "#fef2f2", "dark": "#3a1717", "usage": "Grund kritischer Badges, Hover destruktiver Ghost-Buttons." },
      { "name": "attention",      "light": "#c2410c", "dark": "#fb923c", "usage": "Handlungsbedarf mit Frist («läuft bald ab»)." },
      { "name": "attention-bg",   "light": "#fff7ed", "dark": "#36200f", "usage": "Grund von Frist-Hinweisen." },

      { "name": "avatar-blue-bg",   "light": "#dbeafe", "dark": "#1e3a6e", "usage": "Initialen-Avatar, Text `info`." },
      { "name": "avatar-green-bg",  "light": "#dcfce7", "dark": "#14532d", "usage": "Initialen-Avatar, Text `success-strong`." },
      { "name": "avatar-amber-bg",  "light": "#fef3c7", "dark": "#422d0b", "usage": "Initialen-Avatar, Text `warning-strong`." },
      { "name": "avatar-orange-bg", "light": "#ffedd5", "dark": "#43230e", "usage": "Initialen-Avatar, Text `attention`." },
      { "name": "avatar-pink-bg",   "light": "#fce7f3", "dark": "#4a1d36", "usage": "Initialen-Avatar, Text `avatar-pink`." },
      { "name": "avatar-pink",      "light": "#be185d", "dark": "#f9a8d4", "usage": "Initialen auf `avatar-pink-bg`." },
      { "name": "avatar-indigo-bg", "light": "#e0e7ff", "dark": "#2e2a6b", "usage": "Initialen-Avatar, Text `avatar-indigo`." },
      { "name": "avatar-indigo",    "light": "#4338ca", "dark": "#a5b4fc", "usage": "Initialen auf `avatar-indigo-bg`." }
    ],

    "brand": [
      { "name": "primary",        "usage": "Markenfarbe: Links, aktive Tabs, gesetzte Checkboxen, Auswahl, Fokusring. Mindestens 4.5:1 auf `surface` und `page`." },
      { "name": "on-primary",     "usage": "Text und Icons auf gefülltem `primary`." },
      { "name": "sidebar-bg",     "usage": "Grund der Sidebar. Muss so dunkel sein, dass `sidebar-ink-muted` (70 % Weiss) 4.5:1 erreicht; meist eine dunklere Stufe von `primary`." },
      { "name": "sidebar-border", "usage": "Rechter Rand der Sidebar. Hell meist transparent, dunkel nötig, weil sich Sidebar und Seitengrund kaum unterscheiden." },
      { "name": "sidebar-marker", "usage": "Icon des aktiven Navigationseintrags. Mindestens 3:1 auf `sidebar-active`." },
      { "name": "marker",         "usage": "Akzent für Markierungen ohne Text: Benachrichtigungspunkt, hervorgehobener Diagrammwert. Mindestens 3:1 (v3: #e67e22 erreichte auf Weiss nur 2.85:1)." },
      { "name": "action",         "usage": "Fläche der einen Primäraktion pro Ansicht, Zähler-Badges in der Sidebar, Logo-Platzhalter." },
      { "name": "action-hover",   "usage": "Hover der Primäraktion." },
      { "name": "on-action",      "usage": "Text auf `action` und `action-hover`, Schriftgewicht 600." }
    ],

    "derived": [
      { "name": "focus-ring",      "css": "var(--ds-primary)", "usage": "2px-Umriss mit 2px Abstand bei :focus-visible." },
      { "name": "primary-tint-03", "css": "color-mix(in srgb, var(--ds-primary) 3%, transparent)",  "usage": "Ausgewählte Tabellenzeile." },
      { "name": "primary-tint-04", "css": "color-mix(in srgb, var(--ds-primary) 4%, transparent)",  "usage": "Massenaktionsleiste." },
      { "name": "primary-tint-07", "css": "color-mix(in srgb, var(--ds-primary) 7%, transparent)",  "usage": "Aktive Filter-Chips." },
      { "name": "primary-tint-08", "css": "color-mix(in srgb, var(--ds-primary) 8%, transparent)",  "usage": "Icon-Kacheln." },
      { "name": "primary-tint-10", "css": "color-mix(in srgb, var(--ds-primary) 10%, transparent)", "usage": "Primär-Badges, Zähler im aktiven Tab." },
      { "name": "primary-tint-15", "css": "color-mix(in srgb, var(--ds-primary) 15%, transparent)", "usage": "Aktueller Schritt im StatusStepper." },
      { "name": "primary-tint-20", "css": "color-mix(in srgb, var(--ds-primary) 20%, transparent)", "usage": "Zusätzlicher Fokus-Schatten von Eingabefeldern." },
      { "name": "marker-tint",     "css": "color-mix(in srgb, var(--ds-marker) 12%, transparent)",  "usage": "Grund von Akzent-Icon-Kacheln; das Icon darauf steht in `attention`." },
      { "name": "status-neutral-bg", "css": "var(--ds-divider)",      "usage": "Neutrale Badges («Entwurf»)." },
      { "name": "chart-previous",    "css": "var(--ds-border-strong)", "usage": "Vergleichsserie in Diagrammen." }
    ]
  },

  "profiles": {
    "standard": {
      "label": "Standard (Marineblau)",
      "usage": "Ausgangsprofil des Guides, entspricht den ERP-Mockups.",
      "light": { "primary": "#1e3a5f", "on-primary": "#ffffff", "sidebar-bg": "#1e3a5f", "sidebar-border": "transparent", "sidebar-marker": "#f39a4e", "marker": "#d9731c", "action": "#b35f12", "action-hover": "#9a500f", "on-action": "#ffffff" },
      "dark":  { "primary": "#8fb3e0", "on-primary": "#0b1220", "sidebar-bg": "#0e1a2b", "sidebar-border": "#2a3647",     "sidebar-marker": "#f39a4e", "marker": "#f39a4e", "action": "#f39a4e", "action-hover": "#e0843a", "on-action": "#1c1206" }
    },
    "bandspirit": {
      "label": "BANDspirit (Petrol)",
      "usage": "Markenfarbe Petrol. Die Sidebar ist dunkler als `primary`, weil 70 % Weiss auf #2a6b64 nur 3.1:1 erreicht.",
      "light": { "primary": "#2a6b64", "on-primary": "#ffffff", "sidebar-bg": "#1c4d48", "sidebar-border": "transparent", "sidebar-marker": "#f6a865", "marker": "#d9731c", "action": "#b35f12", "action-hover": "#9a500f", "on-action": "#ffffff" },
      "dark":  { "primary": "#7cc4ba", "on-primary": "#0b1220", "sidebar-bg": "#10302d", "sidebar-border": "#2a3647",     "sidebar-marker": "#f6a865", "marker": "#f39a4e", "action": "#f39a4e", "action-hover": "#e0843a", "on-action": "#1c1206" }
    }
  },

  "contrast": {
    "note": "Paare, die build-tokens.mjs je Profil und Theme prüft. `on` = Grund, auf dem die Vordergrundfarbe steht (Alpha-Werte werden darauf verrechnet).",
    "pairs": [
      { "fg": "ink",               "bg": "surface",        "min": 4.5 },
      { "fg": "ink",               "bg": "page",           "min": 4.5 },
      { "fg": "ink-secondary",     "bg": "column",         "min": 4.5 },
      { "fg": "ink-tertiary",      "bg": "divider",        "min": 4.5 },
      { "fg": "muted",             "bg": "surface",        "min": 4.5 },
      { "fg": "muted",             "bg": "page",           "min": 4.5 },
      { "fg": "muted",             "bg": "divider",        "min": 4.5 },
      { "fg": "input",             "bg": "surface",        "min": 3 },
      { "fg": "input",             "bg": "page",           "min": 3 },
      { "fg": "primary",           "bg": "surface",        "min": 4.5 },
      { "fg": "primary",           "bg": "page",           "min": 4.5 },
      { "fg": "primary",           "bg": "primary-tint-10", "on": "surface", "min": 4.5 },
      { "fg": "on-primary",        "bg": "primary",        "min": 4.5 },
      { "fg": "on-action",         "bg": "action",         "min": 4.5 },
      { "fg": "on-action",         "bg": "action-hover",   "min": 4.5 },
      { "fg": "marker",            "bg": "surface",        "min": 3 },
      { "fg": "sidebar-ink",       "bg": "sidebar-bg",     "min": 4.5 },
      { "fg": "sidebar-ink-muted", "bg": "sidebar-bg",     "min": 4.5 },
      { "fg": "sidebar-ink-strong","bg": "sidebar-active", "on": "sidebar-bg", "min": 4.5 },
      { "fg": "sidebar-marker",    "bg": "sidebar-active", "on": "sidebar-bg", "min": 3 },
      { "fg": "success-strong",    "bg": "success-bg",     "min": 4.5 },
      { "fg": "info",              "bg": "info-bg",        "min": 4.5 },
      { "fg": "warning-strong",    "bg": "warning-bg",     "min": 4.5 },
      { "fg": "danger",            "bg": "danger-bg",      "min": 4.5 },
      { "fg": "danger",            "bg": "surface",        "min": 4.5 },
      { "fg": "on-danger",         "bg": "danger",         "min": 4.5 },
      { "fg": "attention",         "bg": "attention-bg",   "min": 4.5 }
    ]
  },

  "type": {
    "family": "Inter, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
    "styles": [
      { "name": "kpi-value",     "size": "28px", "line": "1.3",  "weight": 600, "tracking": "-0.02em", "usage": "Hauptwert einer KPI-Kachel, tabellarische Ziffern." },
      { "name": "page-title",    "size": "24px", "line": "32px", "weight": 600, "tracking": "-0.02em", "usage": "Ein h1 pro Seite." },
      { "name": "figure",        "size": "20px", "line": "28px", "weight": 600, "usage": "Kennzahl in Übersichtsleisten, Gesamtbetrag." },
      { "name": "section-title", "size": "16px", "line": "24px", "weight": 600, "usage": "Titel eines Panels im Hauptbereich." },
      { "name": "lead",          "size": "14px", "line": "1.5",  "weight": 400, "usage": "Einleitung unter dem Seitentitel, in `muted`." },
      { "name": "card-title",    "size": "14px", "line": "20px", "weight": 600, "usage": "Panels in der rechten Spalte, Kanban-Karten." },
      { "name": "body",          "size": "14px", "line": "1.5",  "weight": 400, "usage": "Standardtext. v3: 13px; 14px ist der Standard, 13px nur für dichte Tabellen." },
      { "name": "body-medium",   "size": "14px", "line": "1.5",  "weight": 500, "usage": "Buttons, Tabs, Namen, Belegnummern." },
      { "name": "small",         "size": "12px", "line": "1.5",  "weight": 400, "usage": "Zweite Zeilen, Metaangaben." },
      { "name": "caption-caps",  "size": "11px", "line": "1.5",  "weight": 500, "tracking": "0.06em", "usage": "Grossbuchstaben: Spaltenköpfe, KPI-Labels, Gruppenlabels." },
      { "name": "badge",         "size": "11px", "line": "1.5",  "weight": 500, "usage": "Status-Badges, Zähler." },
      { "name": "micro",         "size": "10px", "line": "1.5",  "weight": 400, "usage": "Nur Achsen und Initialen in kleinen Avataren." }
    ]
  },

  "spacing": [
    { "name": "space-0-5", "value": "2px" },  { "name": "space-1", "value": "4px" },   { "name": "space-1-5", "value": "6px" },
    { "name": "space-2",   "value": "8px" },  { "name": "space-2-5", "value": "10px" }, { "name": "space-3",   "value": "12px" },
