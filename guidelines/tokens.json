    { "name": "radius-xs", "value": "2px",    "usage": "Diagrammbalken." },
    { "name": "radius-sm", "value": "4px",    "usage": "Checkboxen, Segmente, Tags." },
    { "name": "radius-md", "value": "6px",    "usage": "Buttons, Felder, Icon-Kacheln, Navigation." },
    { "name": "radius-lg", "value": "8px",    "usage": "Panels, Kacheln, Karten, Spalten." },
    { "name": "radius-full", "value": "9999px", "usage": "Badges, Chips, Avatare, Fortschrittsbalken." }
  ],
  "size": [
    { "name": "control-sm", "value": "28px", "usage": "Segmente, Icon-Buttons in Zeilen." },
    { "name": "control-md", "value": "32px", "usage": "Kleine Buttons, Pagination, Avatar in der Topbar." },
    { "name": "control-lg", "value": "36px", "usage": "Standard für Buttons, Felder, Navigationseinträge." },
    { "name": "topbar-height", "value": "64px" },
    { "name": "sidebar-width", "value": "248px" },
    { "name": "filter-panel-width", "value": "256px" },
