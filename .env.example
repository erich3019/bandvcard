# Copy to .env and adjust. Development defaults, not for production.
POSTGRES_DB=bandvcard
POSTGRES_USER=bandvcard
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=bandvcard
MINIO_ROOT_PASSWORD=change-me-too

# The app is served on https://localhost:NGINX_HTTPS_PORT; NGINX_PORT (HTTP) only redirects there.
# NGINX_BIND=0.0.0.0 makes the app reachable from other devices in the network (e.g. a phone).
# In Development there is no login, so then everyone in the network can use the app.
NGINX_BIND=127.0.0.1
NGINX_PORT=8080
NGINX_HTTPS_PORT=8443

# Other host ports (bound to 127.0.0.1)
POSTGRES_PORT=5433
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Microsoft Entra ID app registration (single tenant), used when ASPNETCORE_ENVIRONMENT=Production.
# Redirect URI to register (type "Web"): https://localhost:8443/api/auth/callback
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Development (the default): NO login, everyone who can reach the app is DEV_USER_EMAIL.
# Production: login through Microsoft Entra ID (ENTRA_* above); DEV_USER_EMAIL is ignored.
ASPNETCORE_ENVIRONMENT=Development
DEV_USER_EMAIL=dev@example.com

# Comma-separated email addresses that are admin. They get the role at every login and cannot
# be demoted in the app. Everyone else starts as a normal user; admins assign roles under "Benutzer".
ADMIN_EMAILS=
