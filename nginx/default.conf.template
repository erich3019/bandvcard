# Rendered by the nginx image at container start: ${NGINX_HTTPS_PORT} is replaced from the
# environment, nginx's own $variables are left alone.

# Plain HTTP only redirects to HTTPS. 308 keeps the method, so a POST is not turned into a GET.
server {
    listen 80;
    server_name _;
    return 308 https://$host:${NGINX_HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    # Created by scripts/generate-cert.sh (self-signed, for development).
    ssl_certificate /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Docker's DNS. Resolving per request (via the variables below) keeps nginx working
    # when a container is recreated and gets a new address.
    resolver 127.0.0.11 valid=10s;
    set $frontend http://frontend:3000;
    set $backend http://backend:8080;

    # Business card photos
    client_max_body_size 20m;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    # Always overwritten here so clients cannot spoof the host the backend builds login redirects from.
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The /api prefix is passed through unchanged to the backend.
    location /api/ {
        proxy_pass $backend;
    }

    location / {
        proxy_pass $frontend;
    }
}
